{
  "name": "api-bread-king",
  "version": "1.0.0",
  "description": "To make it easy for you to get started with GitLab, here's a list of recommended next steps.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:rollback": "sequelize-cli db:migrate:undo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/kenshimota/api-bread-king.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://gitlab.com/kenshimota/api-bread-king/issues"
  },
  "homepage": "https://gitlab.com/kenshimota/api-bread-king#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.test\\.js$"
    ]
  }
}

# Archivo: users.http
# Módulo: users  ->  POST /users
# Protegido: requiere un JWT con rol admin.
# Ejecuta antes "POST /auth/login" en auth.http para tener {{token}}.

### POST /users — crea un usuario (201)
# Roles válidos (tabla roles): admin, seller, delivery, freelance_delivery, customer.
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "{{newUserUsername}}",
  "email": "{{newUserEmail}}",
  "password": "{{newUserPassword}}",
  "name": "{{newUserName}}",
  "role": "{{newUserRole}}"
}

### POST /users — sin token (401 Unauthorized)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "{{newUserUsername}}",
  "email": "{{newUserEmail}}",
  "password": "{{newUserPassword}}",
  "role": "{{newUserRole}}"
}

### POST /users — rol inválido (422)
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "pedro",
  "email": "pedro@breadking.com",
  "password": "secreto123",
  "role": "no-existe"
}

### POST /users — faltan campos (400)
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "incompleto"
}

### GET /users — lista los usuarios (200)
# Devuelve id, username, email, name, role e isBlocked, sin password ni roleId.
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

### GET /users — sin token (401 Unauthorized)
GET {{baseUrl}}/users

### PATCH /users/:id/status — bloquea un usuario (200)
# Sustituye 2 por el id del usuario a bloquear.
PATCH {{baseUrl}}/users/2/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isBlocked": true
}

### PATCH /users/:id/status — desbloquea un usuario (200)
PATCH {{baseUrl}}/users/2/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isBlocked": false
}

### PATCH /users/:id/status — falta isBlocked (400)
PATCH {{baseUrl}}/users/2/status
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### PATCH /users/:id/status — isBlocked no booleano (422)
PATCH {{baseUrl}}/users/2/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isBlocked": "true"
}

### PATCH /users/:id/status — intento de bloquearse a sí mismo (409)
# El id debe coincidir con el sub del JWT del administrador.
PATCH {{baseUrl}}/users/1/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isBlocked": true
}

### DELETE /users/:id — elimina un usuario (204, sin cuerpo)
# Sustituye 2 por el id del usuario a eliminar.
DELETE {{baseUrl}}/users/2
Authorization: Bearer {{token}}

### DELETE /users/:id — id inválido (422)
DELETE {{baseUrl}}/users/abc
Authorization: Bearer {{token}}

### DELETE /users/:id — sin token (401 Unauthorized)
DELETE {{baseUrl}}/users/2


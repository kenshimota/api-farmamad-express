PORT=3001
# Environment: `production` forces the strict generic error message (no `debug` field).
# `development` also prints every SQL query with its color and execution time.
NODE_ENV=development
# Minimum level to print: info (default), warn or error
LOG_LEVEL=info
# Define it (even empty) to disable ANSI colours in the logs
NO_COLOR=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bread_king
DB_NAME_TEST=bread_king_test
# Host used by `npm run test:integration` when running from the host machine
DB_HOST_TEST=localhost
DB_USER=bread_king
DB_PASSWORD=bread_king
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
# Allowed CORS origins separated by commas (e.g. https://app.breadking.com,https://admin.breadking.com).
# Leave it empty or unset to allow every origin with "*" until the definitive domain list exists.
CORS_ORIGIN=
# Gmail sender used by the password recovery emails
GMAIL_USERNAME=your-account@gmail.com
GMAIL_TOKEN=your-16-char-app-password

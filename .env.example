PORT=3001
# Environment: `production` forces the strict generic error message (no `debug` field).
# `development` also prints every SQL query with its color and execution time.
NODE_ENV=development
# Minimum level to print: info (default), warn or error
LOG_LEVEL=info
# Define it (even empty) to disable ANSI colours in the logs
NO_COLOR=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bread_king
DB_NAME_TEST=bread_king_test
# Host used by `npm run test:integration` when running from the host machine
DB_HOST_TEST=localhost
DB_USER=bread_king
DB_PASSWORD=bread_king
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
# Allowed CORS origins separated by commas (e.g. https://app.superking.com,https://admin.superking.com).
# Leave it empty or unset to allow every origin with "*" until the definitive domain list exists.
CORS_ORIGIN=
# Gmail sender used by the product emails (recovery and welcome)
GMAIL_USERNAME=your-account@gmail.com
GMAIL_TOKEN=your-16-char-app-password
# Product name shown in the emails; defaults to `Farmamed` when empty/unset
APP_NAME=Farmamed
# Emitter profile printed in the invoice and quotation PDFs (HU-51).
# COMPANY_TAX_ID and COMPANY_ADDRESS are required; without them both PDF
# endpoints answer 503. The rest are optional. The logo is a local image path.
COMPANY_TAX_ID=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_LOGO_PATH=
# Web link included in the welcome email; defaults to `https://farmamed.strixcryptoapp.site/app`
APP_URL=https://farmamed.strixcryptoapp.site/app
# Optional root folder for uploaded files; defaults to <repo>/uploads when empty/unset
UPLOAD_DIR=
# Optional public base URL for image links; defaults to http://localhost:${PORT || 3001}
PUBLIC_BASE_URL=
# Daily expiration job (HU-50). Set LOTS_EXPIRY_JOB_ENABLED=false when an
# external cron runs scripts/expire-lots.js to avoid two internal schedulers.
LOTS_EXPIRY_JOB_ENABLED=true
LOTS_EXPIRY_JOB_HOUR_UTC=4
LOTS_EXPIRY_JOB_MINUTE_UTC=0
LOTS_EXPIRY_JOB_BATCH_SIZE=500
